{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "yomipalette-play-verifier",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "VERIFY_IP_RATE_LIMIT", "namespace_id": "7923001", "simple": { "limit": 30, "period": 60 } },
    { "name": "VERIFY_TOKEN_RATE_LIMIT", "namespace_id": "7923002", "simple": { "limit": 6, "period": 60 } }
  ],
  "triggers": { "crons": ["0 */6 * * *"] },
  "d1_databases": [
    {
      "binding": "ENTITLEMENTS_DB",
      "database_name": "yomipalette-play-entitlements",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON",
      "store_id": "REPLACE_WITH_YOUR_SECRETS_STORE_ID",
      "secret_name": "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"
    }
  ]
}
